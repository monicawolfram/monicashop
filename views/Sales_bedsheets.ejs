<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bedsheet Sales</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <style>
    body { font-family: 'Segoe UI', sans-serif; background: #f4f6f9; }
    .sidebar { height: 100vh; background: #2c3e50; color: #fff; position: fixed; top: 0; left: 0; width: 250px; transition: width 0.3s; overflow-y: auto; }
    .sidebar.collapsed { width: 70px; }
    .sidebar .nav-link { color: #fff; padding: 15px 20px; display: flex; align-items: center; }
    .sidebar .nav-link.active { background: #1abc9c; }
    .main-content { margin-left: 250px; transition: margin-left 0.3s; padding: 20px; }
    .main-content.collapsed { margin-left: 70px; }
    .top-navbar { height: 60px; background: #fff; border-bottom: 1px solid #dee2e6; display: flex; align-items: center; padding: 0 20px; }
    .toggle-btn { cursor: pointer; font-size: 1.2rem; margin-right: 15px; }
    table.table { background: #fff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 6px rgba(0,0,0,0.1); }
    table.table thead { background: #2c3e50; color: #fbbf24; }
    .summary-card { border-radius: 10px; color: #fff; padding: 20px; }
    .bg-today { background: #1abc9c; }
    .bg-week { background: #3498db; }
    .bg-month { background: #9b59b6; }
    .bg-year { background: #e67e22; }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <div class="sidebar" id="sidebar">
    <h4 class="text-center py-3">Bedsheet Panel</h4>
    <ul class="nav flex-column">
      <li><a href="/Bedsheets" class="nav-link"><i class="fas fa-home"></i> <span>Dashboard</span></a></li>
      <li><a href="/Bedsheets/Bedsheet_management" class="nav-link"><i class="fas fa-layer-group"></i> <span>Bedsheet Management</span></a></li>
      <li><a href="/Bedsheets/Sales_bedsheets" class="nav-link active"><i class="fas fa-shopping-cart"></i> <span>Sales</span></a></li>
      <li><a href="/Bedsheets/Products_bedsheets" class="nav-link"><i class="fas fa-box"></i> <span>Products</span></a></li>
      <li><a href="/Bedsheet/Reports_bedsheets" class="nav-link"><i class="fas fa-chart-line"></i> <span>Reports</span></a></li>
    </ul>
  </div>

  <!-- Main Content -->
  <div class="main-content" id="main-content">
    <div class="top-navbar">
      <i class="fas fa-bars toggle-btn" id="toggleSidebar"></i>
      <h5 class="mb-0">Bedsheet Sales</h5>
    </div>

    <div class="container-fluid mt-4">
      <!-- Summary Cards -->
      <div class="row mb-4">
        <div class="col-md-3">
          <div class="summary-card bg-today text-center">
            <h6>Today</h6>
            <h4 id="todayTotal">0</h4>
          </div>
        </div>
        <div class="col-md-3">
          <div class="summary-card bg-week text-center">
            <h6>This Week</h6>
            <h4 id="weekTotal">0</h4>
          </div>
        </div>
        <div class="col-md-3">
          <div class="summary-card bg-month text-center">
            <h6>This Month</h6>
            <h4 id="monthTotal">0</h4>
          </div>
        </div>
        <div class="col-md-3">
          <div class="summary-card bg-year text-center">
            <h6>This Year</h6>
            <h4 id="yearTotal">0</h4>
          </div>
        </div>
      </div>

      <!-- Add Sale Button -->
      <div class="d-flex justify-content-between mb-3">
        <h4>Sales Records</h4>
        <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addSaleModal"><i class="fas fa-plus"></i> Record Sale</button>
      </div>

      <!-- Sales Table -->
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <th>ID</th>
              <th>Responsible</th>
              <th>Customer Name</th>
              <th>Bedsheet</th>
              <th>Type / Size</th>
              <th>Quantity</th>
              <th>Total Price (TZS)</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody id="salesTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Add Sale Modal -->
  <div class="modal fade" id="addSaleModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form id="addSaleForm">
          <div class="modal-header">
            <h5 class="modal-title">Record Sale</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label>Responsible</label>
              <input type="text" class="form-control" id="saleResponsible" required placeholder="Enter staff name">
            </div>
            <div class="mb-3">
              <label>Customer Full Name</label>
              <input type="text" class="form-control" id="customerName" required>
            </div>
            <div class="mb-3">
              <label>Bedsheet</label>
              <select class="form-control" id="saleBedsheet" required>
                <option value="">-- Select Bedsheet --</option>
                <option value="1" data-price="25000" data-size="Single">Sleepy (Single) - 25,000 TZS</option>
                <option value="2" data-price="30000" data-size="Double">Dreamy (Double) - 30,000 TZS</option>
                <option value="3" data-price="35000" data-size="Queen">Cozy (Queen) - 35,000 TZS</option>
                <option value="4" data-price="40000" data-size="King">Luxury (King) - 40,000 TZS</option>
                <option value="5" data-price="45000" data-size="Super King">Royal (Super King) - 45,000 TZS</option>
              </select>
            </div>
            <div class="mb-3">
              <label>Type / Size</label>
              <input type="text" class="form-control" id="saleType" readonly>
            </div>
            <div class="mb-3">
              <label>Quantity</label>
              <input type="number" class="form-control" id="saleQuantity" min="1" required>
            </div>
            <div class="mb-3">
              <label>Total Price (TZS)</label>
              <input type="text" class="form-control" id="saleTotal" readonly>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="submit" class="btn btn-success">Save Sale</button>
          </div>
        </form>
      </div>
    </div>
  </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
let sales = [];

// Auto-fill size when selecting bedsheet
document.getElementById("saleBedsheet").addEventListener("change", function() {
  const selected = this.options[this.selectedIndex];
  document.getElementById("saleType").value = selected?.dataset.size || "";
  calcTotal();
});

// Auto-calc total price
document.getElementById("saleQuantity").addEventListener("input", calcTotal);

function calcTotal() {
  const bedsheet = document.getElementById("saleBedsheet");
  const quantity = parseInt(document.getElementById("saleQuantity").value) || 0;
  const price = parseInt(bedsheet.options[bedsheet.selectedIndex]?.dataset.price) || 0;
  document.getElementById("saleTotal").value = (quantity * price).toLocaleString();
}

// Load sales from server
async function loadSales() {
  try {
    const res = await fetch("/sales-bedsheets");
    sales = await res.json();
    const tbody = document.getElementById("salesTableBody");
    tbody.innerHTML = "";

    sales.forEach(s => {
      const row = document.createElement("tr");
      row.innerHTML = `
        <td>${s.id}</td>
        <td>${s.responsible}</td>
        <td>${s.customer_name}</td>
        <td>${s.brand}</td>
        <td>${s.type}</td>
        <td>${s.quantity}</td>
        <td>${s.total_price.toLocaleString()}</td>
        <td>${new Date(s.date).toLocaleString()}</td>
        <td>
          <button class="btn btn-sm btn-danger" onclick="deleteSale(${s.id})">
            <i class="fas fa-trash"></i>
          </button>
        </td>
      `;
      tbody.appendChild(row);
    });

    updateTotals();
  } catch(err) {
    console.error("Failed to load sales:", err);
  }
}

// Update totals (Today / Week / Month / Year)
function updateTotals() {
  const now = new Date();
  let today = 0, week = 0, month = 0, year = 0;

  sales.forEach(s => {
    const d = new Date(s.date);
    const total = s.total_price;

    if (d.toDateString() === now.toDateString()) today += total;
    if (d.getFullYear() === now.getFullYear()) {
      year += total;
      if (d.getMonth() === now.getMonth()) month += total;
      const diffDays = (now - d) / (1000 * 60 * 60 * 24);
      if (diffDays <= 7) week += total;
    }
  });

  document.getElementById("todayTotal").innerText = today.toLocaleString();
  document.getElementById("weekTotal").innerText = week.toLocaleString();
  document.getElementById("monthTotal").innerText = month.toLocaleString();
  document.getElementById("yearTotal").innerText = year.toLocaleString();
}

// Submit sale
document.getElementById("addSaleForm").addEventListener("submit", async function(e){
  e.preventDefault();
  const data = {
    responsible: document.getElementById("saleResponsible").value,
    customer_name: document.getElementById("customerName").value,
    bedsheet_id: parseInt(document.getElementById("saleBedsheet").value),
    type: document.getElementById("saleType").value,
    quantity: parseInt(document.getElementById("saleQuantity").value)
  };

  try {
    const res = await fetch("/add-bedsheets", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });
    const result = await res.json();
    if(result.message) alert(result.message);

    loadSales();
    this.reset();
    document.getElementById("saleTotal").value = "";
    bootstrap.Modal.getInstance(document.getElementById("addSaleModal")).hide();
  } catch(err) {
    console.error("Failed to add sale:", err);
  }
});

// Delete Sale
async function deleteSale(id) {
  if(confirm("Delete this sale?")) {
    try {
      const res = await fetch(`/delete/${id}`, { method: "DELETE" });
      const result = await res.json();
      if(result.message) alert(result.message);
      loadSales();
    } catch(err) {
      console.error("Failed to delete sale:", err);
    }
  }
}

// Initial load
loadSales();
</script>


</body>
</html>
